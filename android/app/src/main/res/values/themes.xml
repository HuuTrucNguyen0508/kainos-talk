<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The switchboard surface colour, so the window behind Compose matches it while it starts. -->
    <style name="Theme.KainosTalk" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F6F8F7</item>
    </style>

    <!-- See-through window for share target and clipboard Quick Settings tile activities. -->
    <style name="Theme.KainosTalk.Translucent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
